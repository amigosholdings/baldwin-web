{
  "name": "trackmyhairloss-content",
  "private": true,
  "version": "4.0.0",
  "type": "module",
  "scripts": {
    "queue:create": "wrangler queues create trackmyhairloss-content-jobs || true",
    "deploy": "npm run queue:create && wrangler deploy",
    "dev": "wrangler dev",
    "migrate": "wrangler d1 execute baldwin-growth --remote --file=./migration-v2.sql",
    "seed": "wrangler d1 execute baldwin-growth --remote --file=./seed.sql",
    "check": "node --check src/index.js && node --check src/worker.js && node --test test/*.test.mjs",
    "test": "node --test test/*.test.mjs",
    "migrate:v4": "wrangler d1 execute baldwin-growth --remote --file=./migration-v3.sql"
  },
  "devDependencies": {
    "wrangler": "^4.130.0"
  }
}
