{
  "name": "baldwin-getbaldwin",
  "main": "./src/index.js",
  "compatibility_date": "2026-09-14",
  "workers_dev": true,
  "keep_vars": true,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/download",
      "/download/*"
    ]
  }
}
